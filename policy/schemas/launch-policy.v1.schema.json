{
  "$defs": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "checkerOnly": { "type": "boolean" },
        "independentAudit": { "const": false },
        "launchAuthorized": { "const": false },
        "productionDiscoveryAllowed": { "type": "boolean" },
        "publicRoutingAllowed": { "type": "boolean" },
        "realUserFundsAllowed": { "type": "boolean" }
      },
      "required": ["checkerOnly", "independentAudit", "launchAuthorized", "productionDiscoveryAllowed", "publicRoutingAllowed", "realUserFundsAllowed"],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "authority": { "$ref": "#/$defs/authority" },
        "enabled": { "type": "boolean" },
        "id": { "enum": ["build", "production-launch", "workflow-canary"] },
        "outcome": { "type": ["string", "null"] }
      },
      "required": ["authority", "enabled", "id", "outcome"],
      "type": "object"
    },
    "rule": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": { "mode": { "enum": ["always", "historical"] } },
              "required": ["mode"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "equals": { "type": "boolean" },
                "field": { "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$", "type": "string" },
                "mode": { "const": "when" }
              },
              "required": ["equals", "field", "mode"],
              "type": "object"
            }
          ]
        },
        "enforcement": {
          "additionalProperties": false,
          "properties": {
            "handlerId": { "type": ["string", "null"] },
            "mode": { "enum": ["deterministic", "human", "legacy-adapter"] },
            "owner": { "enum": ["applicant", "maintainer", "platform"] }
          },
          "required": ["handlerId", "mode", "owner"],
          "type": "object"
        },
        "evidence": {
          "items": { "pattern": "^[a-z0-9][a-z0-9-]{1,79}$", "type": "string" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": { "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$", "type": "string" },
        "introducedIn": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "parameters": { "type": "object" },
        "profiles": {
          "items": { "enum": ["build", "production-launch", "workflow-canary"] },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requirement": { "maxLength": 500, "minLength": 1, "type": "string" },
        "retiredIn": {
          "anyOf": [
            { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
            { "type": "null" }
          ]
        },
        "severity": { "enum": ["blocker", "required"] },
        "status": { "enum": ["active", "inactive"] }
      },
      "required": ["applicability", "enforcement", "evidence", "id", "introducedIn", "profiles", "requirement", "retiredIn", "severity", "status"],
      "type": "object"
    }
  },
  "$id": "https://programmable.money/schemas/launch-policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effective": {
      "additionalProperties": false,
      "properties": {
        "startsAt": { "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string" },
        "state": { "const": "current" }
      },
      "required": ["startsAt", "state"],
      "type": "object"
    },
    "migration": {
      "additionalProperties": false,
      "properties": {
        "emergencyAction": { "type": "null" },
        "openApplications": { "const": "re-evaluate-current-policy" },
        "previouslyAcceptedRevisions": { "const": "preserve-unless-explicit-emergency" }
      },
      "required": ["emergencyAction", "openApplications", "previouslyAcceptedRevisions"],
      "type": "object"
    },
    "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
    "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
    "profiles": {
      "items": { "$ref": "#/$defs/profile" },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": { "const": "main" },
        "name": { "const": "0xprogrammable/submit-launch" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" }
      },
      "required": ["branch", "name", "numericRepositoryId", "path"],
      "type": "object"
    },
    "rules": {
      "items": { "$ref": "#/$defs/rule" },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": { "const": "programmable.launch-policy.v1" }
  },
  "required": ["effective", "migration", "policyId", "policyVersion", "profiles", "repository", "rules", "schemaVersion"],
  "title": "Programmable Launch Policy V1",
  "type": "object"
}
