{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:applicant-validator-package-receipt:1.0.0",
  "title": "Programmable Applicant Validator Package Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "algorithm",
    "authority",
    "closureSha256",
    "entrypoint",
    "fileCount",
    "files",
    "kind",
    "schemaVersion",
    "totalBytes"
  ],
  "properties": {
    "$schema": {
      "const": "urn:programmable:applicant-validator-package-receipt:1.0.0"
    },
    "algorithm": {
      "const": "sha256-path-nul-size-nul-content-nul-v1"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCodeExecuted",
        "credentialsUsed",
        "externalWritesPerformed",
        "networkAccessed"
      ],
      "properties": {
        "candidateCodeExecuted": {
          "const": false
        },
        "credentialsUsed": {
          "const": false
        },
        "externalWritesPerformed": {
          "const": false
        },
        "networkAccessed": {
          "const": false
        }
      }
    },
    "closureSha256": {
      "$ref": "#/$defs/sha256"
    },
    "entrypoint": {
      "const": "scripts/public-applicant-validator.mjs"
    },
    "fileCount": {
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "byteLength",
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "byteLength": {
            "minimum": 0,
            "maximum": 4194304,
            "type": "integer"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "role": {
            "enum": [
              "data",
              "entrypoint",
              "module",
              "schema"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "kind": {
      "const": "programmable-applicant-validator-package-receipt"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "totalBytes": {
      "minimum": 1,
      "maximum": 16777216,
      "type": "integer"
    }
  },
  "$defs": {
    "path": {
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\\\u0000\\r\\n]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
