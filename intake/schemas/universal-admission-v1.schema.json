{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:universal-admission:1.0.0",
  "title": "Programmable Universal Admission Envelope V1",
  "description": "A small, project-agnostic intake envelope. It establishes identity and truthful disclosure for review; it is not an audit, approval, routing decision, or launch authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "application",
    "attestation",
    "disclosure",
    "kind",
    "schemaVersion",
    "source"
  ],
  "properties": {
    "$schema": { "const": "urn:programmable:universal-admission:1.0.0" },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "stage", "requestedRoute", "projectLabel"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "pattern": "^[1-9][0-9]{0,30}$", "type": "string" },
        "stage": { "enum": ["proposal", "prototype", "launch-request"] },
        "requestedRoute": { "enum": ["none", "programmable-ethereum-mainnet", "other"] },
        "projectLabel": { "maxLength": 160, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCodeExecuted",
        "externalWritesPerformed",
        "noApprovalClaim",
        "noSafetyGuaranteeClaim",
        "publicDataOnly",
        "unknownsExplicit"
      ],
      "properties": {
        "candidateCodeExecuted": { "const": false },
        "externalWritesPerformed": { "const": false },
        "noApprovalClaim": { "const": true },
        "noSafetyGuaranteeClaim": { "const": true },
        "publicDataOnly": { "const": true },
        "unknownsExplicit": { "const": true }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "executionSurfaces", "privileges", "valueFlows"],
      "properties": {
        "dependencies": {
          "items": { "$ref": "#/$defs/dependency" },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "executionSurfaces": {
          "items": { "$ref": "#/$defs/surface" },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "privileges": {
          "items": { "$ref": "#/$defs/privilege" },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "valueFlows": {
          "items": { "$ref": "#/$defs/valueFlow" },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "evidence": {
          "items": { "$ref": "#/$defs/evidence" },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        }
      }
    },
    "kind": { "const": "programmable-universal-admission" },
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "commit", "tree", "path", "packageSha256"],
      "properties": {
        "repositoryUrl": { "maxLength": 2048, "minLength": 12, "pattern": "^https://[A-Za-z0-9.-]+(?:/[^\\s\\u0000\\r\\n?#]*)?$", "type": "string" },
        "repositoryId": { "maxLength": 32, "pattern": "^[0-9]{1,32}$", "type": "string" },
        "commit": { "$ref": "#/$defs/objectId" },
        "tree": { "$ref": "#/$defs/objectId" },
        "path": { "$ref": "#/$defs/path" },
        "packageSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "failureMode", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/label" },
        "status": { "$ref": "#/$defs/status" },
        "failureMode": { "maxLength": 600, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["source", "test", "observed", "external", "self-reported"] },
        "ref": { "maxLength": 512, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "status": { "enum": ["declared", "observed", "independently-verified", "unknown"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "label": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\s\\u0000\\r\\n]+(?:[ \\t]+[^\\s\\u0000\\r\\n]+)*$",
      "type": "string"
    },
    "objectId": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "path": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[^\\\\\\u0000\\r\\n]+$",
      "type": "string"
    },
    "privilege": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "summary", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/label" },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "maxLength": 600, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "sourceRefs": {
      "items": { "$ref": "#/$defs/path" },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": { "enum": ["declared", "not-applicable", "unknown"] },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "summary", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/label" },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "maxLength": 1000, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "valueFlow": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {
          "properties": { "kind": { "const": "none" }, "status": { "const": "declared" } },
          "required": ["kind", "status"]
        },
        "then": { "properties": { "from": { "const": "none" }, "to": { "const": "none" } } }
      }],
      "required": ["id", "kind", "status", "from", "to", "basis", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["none", "swap", "fee", "reward", "custody", "other"] },
        "status": { "$ref": "#/$defs/status" },
        "from": { "maxLength": 160, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "to": { "maxLength": 160, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "basis": { "maxLength": 320, "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$", "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" }
  }
}
