{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:universal-admission-runtime-policy:1.0.0",
  "title": "Programmable Universal Admission Runtime Policy V1",
  "description": "Provider-neutral operational capacity and retry limits. These limits are transport controls, not project admission, safety, approval, or launch rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "commandReplayRetentionMs",
    "deadLetterPayloadRetentionMs",
    "fixedWindowMs",
    "kind",
    "leaseDurationMs",
    "maxApplicationOutstanding",
    "maxAttempts",
    "maxDurableCommandBytes",
    "maxDurableCommands",
    "maxGlobalLeased",
    "maxGlobalOutstanding",
    "maxLeaseDurationMs",
    "maxLeaseRenewals",
    "maxRedrives",
    "maxTenantAuthenticatedRequestBytesPerWindow",
    "maxTenantAuthenticatedRequestsPerWindow",
    "maxTenantLeased",
    "maxTenantNewBytesPerWindow",
    "maxTenantNewJobsPerWindow",
    "maxTenantOutstanding",
    "maxTenantReplayBytes",
    "maxTenantReplayRecords",
    "orphanRetentionMs",
    "retryBaseMs",
    "retryMaxMs",
    "schemaVersion",
    "terminalPayloadRetentionMs"
  ],
  "properties": {
    "$schema": { "const": "urn:programmable:universal-admission-runtime-policy:1.0.0" },
    "commandReplayRetentionMs": { "$ref": "#/$defs/positiveDecimal" },
    "deadLetterPayloadRetentionMs": { "$ref": "#/$defs/positiveDecimal" },
    "fixedWindowMs": { "$ref": "#/$defs/positiveDecimal" },
    "kind": { "const": "programmable-universal-admission-runtime-policy" },
    "leaseDurationMs": { "$ref": "#/$defs/positiveDecimal" },
    "maxApplicationOutstanding": { "$ref": "#/$defs/positiveDecimal" },
    "maxAttempts": { "$ref": "#/$defs/positiveDecimal" },
    "maxDurableCommandBytes": { "$ref": "#/$defs/positiveDecimal" },
    "maxDurableCommands": { "$ref": "#/$defs/positiveDecimal" },
    "maxGlobalLeased": { "$ref": "#/$defs/positiveDecimal" },
    "maxGlobalOutstanding": { "$ref": "#/$defs/positiveDecimal" },
    "maxLeaseDurationMs": { "$ref": "#/$defs/positiveDecimal" },
    "maxLeaseRenewals": { "$ref": "#/$defs/decimal" },
    "maxRedrives": { "$ref": "#/$defs/decimal" },
    "maxTenantAuthenticatedRequestBytesPerWindow": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantAuthenticatedRequestsPerWindow": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantLeased": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantNewBytesPerWindow": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantNewJobsPerWindow": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantOutstanding": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantReplayBytes": { "$ref": "#/$defs/positiveDecimal" },
    "maxTenantReplayRecords": { "$ref": "#/$defs/positiveDecimal" },
    "orphanRetentionMs": { "$ref": "#/$defs/positiveDecimal" },
    "retryBaseMs": { "$ref": "#/$defs/positiveDecimal" },
    "retryMaxMs": { "$ref": "#/$defs/positiveDecimal" },
    "schemaVersion": { "const": "1.0.0" },
    "terminalPayloadRetentionMs": { "$ref": "#/$defs/positiveDecimal" }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17})$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    }
  }
}
