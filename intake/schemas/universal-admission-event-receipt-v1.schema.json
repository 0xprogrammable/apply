{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:universal-admission-event-receipt:1.0.0",
  "title": "Programmable Universal Admission Event Receipt V1",
  "description": "An immutable hash-chain event for the transport state machine. Processing events never grant approval, audit, safety, deployment, or launch authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "authority",
    "capacityPolicySha256",
    "eventIndex",
    "eventType",
    "failure",
    "idempotencyKey",
    "job",
    "kind",
    "lease",
    "occurredAtMs",
    "previousReceiptSha256",
    "principalBindingSha256",
    "request",
    "result",
    "schemaVersion",
    "serviceAudience",
    "transition",
    "workerBindingSha256"
  ],
  "properties": {
    "$schema": { "const": "urn:programmable:universal-admission-event-receipt:1.0.0" },
    "authority": { "$ref": "#/$defs/inertAuthority" },
    "capacityPolicySha256": { "$ref": "#/$defs/sha256" },
    "eventIndex": { "$ref": "#/$defs/positiveDecimal" },
    "eventType": { "enum": ["queued", "lease-claimed", "lease-renewed", "retry-scheduled", "dead-lettered", "dead-letter-redriven", "processing-completed"] },
    "failure": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/failure" }] },
    "idempotencyKey": { "$ref": "#/$defs/sha256" },
    "job": { "$ref": "#/$defs/job" },
    "kind": { "const": "programmable-universal-admission-event-receipt" },
    "lease": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lease" }] },
    "occurredAtMs": { "$ref": "#/$defs/decimal" },
    "previousReceiptSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "principalBindingSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "request": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/request" }] },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }] },
    "schemaVersion": { "const": "1.0.0" },
    "serviceAudience": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "transition": { "$ref": "#/$defs/transition" },
    "workerBindingSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "queued" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "job": { "$ref": "#/$defs/initialJob" },
          "lease": { "type": "null" },
          "principalBindingSha256": { "$ref": "#/$defs/sha256" },
          "request": { "$ref": "#/$defs/request" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionNoneToQueued" },
          "workerBindingSha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "lease-claimed" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "job": { "$ref": "#/$defs/leasedJob" },
          "lease": { "$ref": "#/$defs/lease" },
          "principalBindingSha256": { "type": "null" },
          "request": { "type": "null" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionWaitingToLeased" },
          "workerBindingSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "lease-renewed" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "job": { "$ref": "#/$defs/leasedJob" },
          "lease": { "$ref": "#/$defs/lease" },
          "principalBindingSha256": { "type": "null" },
          "request": { "type": "null" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionLeasedToLeased" },
          "workerBindingSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "retry-scheduled" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "$ref": "#/$defs/failure" },
          "job": { "$ref": "#/$defs/leasedJob" },
          "lease": { "$ref": "#/$defs/lease" },
          "principalBindingSha256": { "type": "null" },
          "request": { "type": "null" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionLeasedToRetry" },
          "workerBindingSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "dead-lettered" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "$ref": "#/$defs/failure" },
          "job": { "$ref": "#/$defs/leasedJob" },
          "lease": { "$ref": "#/$defs/lease" },
          "principalBindingSha256": { "type": "null" },
          "request": { "type": "null" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionLeasedToDead" },
          "workerBindingSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "dead-letter-redriven" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "lease": { "type": "null" },
          "principalBindingSha256": { "$ref": "#/$defs/sha256" },
          "request": { "type": "null" },
          "result": { "type": "null" },
          "transition": { "$ref": "#/$defs/transitionDeadToQueued" },
          "workerBindingSha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "processing-completed" } }, "required": ["eventType"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "job": { "$ref": "#/$defs/leasedJob" },
          "lease": { "$ref": "#/$defs/lease" },
          "principalBindingSha256": { "type": "null" },
          "request": { "type": "null" },
          "result": { "$ref": "#/$defs/result" },
          "transition": { "$ref": "#/$defs/transitionLeasedToCompleted" },
          "workerBindingSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,17})$" },
    "positiveDecimal": { "type": "string", "pattern": "^[1-9][0-9]{0,17}$" },
    "applicationRevision": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detailsSha256", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
        "detailsSha256": { "$ref": "#/$defs/sha256" },
        "retryable": { "type": "boolean" }
      }
    },
    "inertAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissionDecisionGranted", "approvalGranted", "auditCompleted", "deploymentPerformed", "fundMovementAuthorized", "fundMovementPerformed", "independentAudit", "launchAuthorized", "repositoryOwnershipProven", "reviewCompleted", "safetyCertified", "safetyGuaranteed"],
      "properties": {
        "admissionDecisionGranted": { "const": false },
        "approvalGranted": { "const": false },
        "auditCompleted": { "const": false },
        "deploymentPerformed": { "const": false },
        "fundMovementAuthorized": { "const": false },
        "fundMovementPerformed": { "const": false },
        "independentAudit": { "const": false },
        "launchAuthorized": { "const": false },
        "repositoryOwnershipProven": { "const": false },
        "reviewCompleted": { "const": false },
        "safetyCertified": { "const": false },
        "safetyGuaranteed": { "const": false }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissionDigest", "applicationId", "attempt", "availableAtMs", "cycle", "enqueueOrdinal", "fenceToken", "jobId", "revision", "revisionBindingSha256", "revisionKey", "tenantId"],
      "properties": {
        "admissionDigest": { "$ref": "#/$defs/sha256" },
        "applicationId": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "attempt": { "$ref": "#/$defs/decimal" },
        "availableAtMs": { "$ref": "#/$defs/decimal" },
        "cycle": { "$ref": "#/$defs/decimal" },
        "enqueueOrdinal": { "$ref": "#/$defs/positiveDecimal" },
        "fenceToken": { "$ref": "#/$defs/decimal" },
        "jobId": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/applicationRevision" },
        "revisionBindingSha256": { "$ref": "#/$defs/sha256" },
        "revisionKey": { "$ref": "#/$defs/sha256" },
        "tenantId": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" }
      }
    },
    "initialJob": {
      "allOf": [
        { "$ref": "#/$defs/job" },
        {
          "type": "object",
          "properties": {
            "attempt": { "const": "0" },
            "cycle": { "const": "0" },
            "fenceToken": { "const": "0" }
          }
        }
      ]
    },
    "leasedJob": {
      "allOf": [
        { "$ref": "#/$defs/job" },
        {
          "type": "object",
          "properties": {
            "attempt": { "$ref": "#/$defs/positiveDecimal" },
            "fenceToken": { "$ref": "#/$defs/positiveDecimal" }
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimedAtMs", "claimOrdinal", "expiresAtMs", "fenceToken", "leaseId", "renewals", "workerBindingSha256"],
      "properties": {
        "claimedAtMs": { "$ref": "#/$defs/decimal" },
        "claimOrdinal": { "$ref": "#/$defs/positiveDecimal" },
        "expiresAtMs": { "$ref": "#/$defs/positiveDecimal" },
        "fenceToken": { "$ref": "#/$defs/positiveDecimal" },
        "leaseId": { "$ref": "#/$defs/sha256" },
        "renewals": { "$ref": "#/$defs/decimal" },
        "workerBindingSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactsSha256", "reportSha256", "resultSha256", "reviewState"],
      "properties": {
        "artifactsSha256": { "$ref": "#/$defs/sha256" },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" },
        "reviewState": { "enum": ["analysis_pending", "ready_for_review"] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticatedRequestByteLength", "expectedCapacityPolicySha256", "requestDigest", "requestId"],
      "properties": {
        "authenticatedRequestByteLength": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,4}|1[0-9]{5}|2[0-5][0-9]{4}|26[0-5][0-9]{3}|266[0-2][0-9]{2}|26630[0-4])$"
        },
        "expectedCapacityPolicySha256": { "$ref": "#/$defs/sha256" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      }
    },
    "state": { "enum": ["queued", "leased", "retry-wait", "dead-lettered", "processing-completed"] },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/state" }] },
        "to": { "$ref": "#/$defs/state" }
      }
    },
    "transitionNoneToQueued": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "type": "null" }, "to": { "const": "queued" } }
    },
    "transitionWaitingToLeased": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "enum": ["queued", "retry-wait"] }, "to": { "const": "leased" } }
    },
    "transitionLeasedToLeased": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "const": "leased" }, "to": { "const": "leased" } }
    },
    "transitionLeasedToRetry": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "const": "leased" }, "to": { "const": "retry-wait" } }
    },
    "transitionLeasedToDead": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "const": "leased" }, "to": { "const": "dead-lettered" } }
    },
    "transitionDeadToQueued": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "const": "dead-lettered" }, "to": { "const": "queued" } }
    },
    "transitionLeasedToCompleted": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "const": "leased" }, "to": { "const": "processing-completed" } }
    }
  }
}
